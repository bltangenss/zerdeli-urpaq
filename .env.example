# Required at runtime; keep every value server-only.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional; these defaults are used when omitted.
GOOGLE_SHEETS_REGISTRATIONS_TAB=Registrations
GOOGLE_SHEETS_PURCHASES_TAB=Purchases
GOOGLE_SHEETS_SETTINGS_TAB=Settings

# Admin users: generate passwordHash with `npm run admin:hash-password`
ADMIN_USERS_JSON='[{"email":"admin@example.kz","passwordHash":"$2b$12$..."}]'

# At least 32 random characters
SESSION_SECRET=

# Optional outside a custom production domain. Do not add a trailing slash.
# Vercel preview/deployment domains are also accepted through VERCEL_URL automatically.
APP_ORIGIN=
